# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- extraction (only when extraction.provider is "anthropic" or "gemini") ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- email (default): existing Gmail account with 2-Step Verification ---
# Use a Google App Password, not your normal Google password. Send tests to yourself.
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=

# --- messaging: pick one channel in config.toml (notify.channel) ---
# Recipient in international format, e.g. +923001234567 (send tests to yourself only)
WHATSAPP_TO=

# whatsapp_cloud: Meta developer app -> WhatsApp -> API Setup (free test number)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# twilio_whatsapp (optional): legacy Console -> Messaging -> Try it out -> WhatsApp sandbox
# The newer trial's preset-template-only flow cannot send this app's custom summary.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# --- code quality (SonarQube token, local only) ---
SONAR_TOKEN=
